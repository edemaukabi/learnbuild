# /etc/nginx/sites-available/your-app-api
# Replace YOUR_DOMAIN with your actual domain (e.g. myapp-api.example.com)
# Symlink: sudo ln -s /etc/nginx/sites-available/your-app-api /etc/nginx/sites-enabled/

# Step 1: deploy this HTTP-only block first, reload nginx, then run certbot.
# Certbot will add the SSL server block automatically.

server {
    listen 80;
    server_name YOUR_DOMAIN;

    client_max_body_size 2G;

    location / {
        proxy_pass         http://localhost:8005;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection 'upgrade';
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 300s;
    }
}

