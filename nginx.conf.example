# /etc/nginx/sites-available/learnbuild-api
# Symlink: sudo ln -s /etc/nginx/sites-available/learnbuild-api /etc/nginx/sites-enabled/

server {
    listen 80;
    server_name learnbuild-api.edemaukabi.dev;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name learnbuild-api.edemaukabi.dev;

    ssl_certificate     /etc/letsencrypt/live/learnbuild-api.edemaukabi.dev/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/learnbuild-api.edemaukabi.dev/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 2G;   # for video uploads

    location / {
        proxy_pass         http://localhost:8005;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection 'upgrade';
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 300s;   # for video uploads
    }
}
