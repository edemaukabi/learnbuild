# App
NODE_ENV=development
PORT=8005

# Database
DATABASE_URL=postgresql://learnbuild:learnbuild_dev@localhost:5435/learnbuild

# Postgres (for production.yml Docker Compose)
POSTGRES_USER=learnbuild
POSTGRES_PASSWORD=changeme
POSTGRES_DB=learnbuild

# Redis
REDIS_URL=redis://localhost:6382

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars

# Cookies
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

# CORS
CORS_ORIGIN=http://localhost:3000

# Paystack
PAYSTACK_SECRET_KEY=sk_test_your_key_here
PAYSTACK_WEBHOOK_SECRET=your_webhook_secret_here

# Bunny.net Stream
BUNNY_API_KEY=
BUNNY_LIBRARY_ID=
BUNNY_CDN_HOSTNAME=

# Storage provider — 'cloudinary' (default) or 'r2'
STORAGE_PROVIDER=cloudinary

# Cloudinary (active default)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudflare R2 (set STORAGE_PROVIDER=r2 to use instead)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=learnbuild-assets

# Email (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Admin
ADMIN_EMAIL=edemaukabi@gmail.com
ADMIN_PASSWORD=changeme123!
