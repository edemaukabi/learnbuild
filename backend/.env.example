# App
NODE_ENV=development
PORT=8005

# Database — local (overridden in Docker Compose via environment block)
DATABASE_URL=postgresql://learnbuild:learnbuild_dev@localhost:5435/learnbuild

# Postgres credentials (used by production.yml Docker Compose)
POSTGRES_USER=learnbuild
POSTGRES_PASSWORD=changeme
POSTGRES_DB=learnbuild

# Redis — local (overridden in Docker Compose via environment block)
REDIS_URL=redis://localhost:6382

# JWT — generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars

# Cookies
COOKIE_SECURE=false           # true in production
COOKIE_DOMAIN=localhost       # .edemaukabi.dev in production

# CORS
CORS_ORIGIN=http://localhost:3000   # https://learnbuild.edemaukabi.dev in production

# Paystack
PAYSTACK_SECRET_KEY=sk_test_your_key_here
PAYSTACK_WEBHOOK_SECRET=your_paystack_secret_key_here

# Storage provider — 'cloudinary' (default) or 'r2'
STORAGE_PROVIDER=cloudinary

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudflare R2 (set STORAGE_PROVIDER=r2 to use instead)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=learnbuild-assets

# Email (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Admin seed
ADMIN_EMAIL=edemaukabi@gmail.com
